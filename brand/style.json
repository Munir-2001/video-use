{
  "handle": "@yourhandle",
  "name": "Munir Abbasi",
  "fonts": {
    "display": {
      "family": "Inter",
      "weight": 800,
      "file": "brand/fonts/Inter-ExtraBold.ttf",
      "fallback": "Helvetica Neue"
    },
    "body": {
      "family": "Inter",
      "weight": 600,
      "file": "brand/fonts/Inter-SemiBold.ttf",
      "fallback": "Helvetica Neue"
    },
    "mono": {
      "family": "JetBrains Mono",
      "weight": 500,
      "file": "brand/fonts/JetBrainsMono-Medium.ttf",
      "fallback": "Menlo"
    },
    "_note": "Drop .ttf files into brand/fonts/. Agents assert the font loaded; a missing file falls back and is reported, never silent."
  },
  "colors": {
    "background": "#0B0B0F",
    "surface": "#15161C",
    "text": "#F5F5F7",
    "text_muted": "#A0A3AD",
    "accent": "#F4502A",
    "accent_2": "#1F5BFF",
    "danger": "#EF476F",
    "caption_base": "#F5F5F7",
    "caption_highlight": "#F4502A",
    "caption_outline": "#000000",
    "paper": "#F3EEE4",
    "ink": "#141418",
    "paper_muted": "#6E6A64",
    "paper_line": "#DCD6CA",
    "_palette": "Paper & Flame (decided 2026-11-16): warm off-white paper panels with ink text, flame-orange accent, cobalt second accent; near-black only for full-frame cards and the footage edge. One accent everywhere so the reels are recognisable."
  },
  "captions": {
    "case": "sentence",
    "words_per_cue": {
      "target": 2,
      "max": 3
    },
    "font": "display",
    "size_px_1080w": 80,
    "size_px_1080x1920": 96,
    "highlight": {
      "scale": 1.12,
      "color": "caption_highlight",
      "base_color": "caption_base"
    },
    "outline_px": 4,
    "shadow_px": 2,
    "position": {
      "vertical": {
        "anchor": "middle",
        "y_fraction": 0.68,
        "band": [
          0.64,
          0.72
        ],
        "note": "lower band, just under the chin for a centred head: never over the face, above the bottom 20 % platform UI"
      },
      "horizontal": {
        "anchor": "bottom",
        "y_fraction": 0.84,
        "note": "bottom band, above the bottom 10 %"
      }
    },
    "max_width_fraction": 0.8,
    "motion": {
      "pop_ms": 120,
      "pop_from": 0.86,
      "rise_px": 28,
      "fade_in_ms": 80,
      "note": "spoken word pops from 86 % to the highlight scale; each cue rises into place with a short fade (ASS tags, burned by libass)"
    },
    "presets": {
      "panel": {
        "description": "small line at the bottom edge of a split_top panel",
        "words_per_cue": {
          "target": 2,
          "max": 3
        },
        "size_px": 64,
        "y_fraction": 0.465
      },
      "big": {
        "description": "hook / CTA: 2-3 words per cue, bigger, lower on the chest; CTA pill under it",
        "words_per_cue": {
          "target": 2,
          "max": 3
        },
        "size_px": 120,
        "y_fraction": 0.64,
        "cta_pill_y": 0.715,
        "tagline_y": 0.76
      }
    }
  },
  "safe_areas": {
    "vertical": {
      "bottom_clear_fraction": 0.2,
      "right_clear_px": 140,
      "top_clear_fraction": 0.08
    },
    "horizontal": {
      "bottom_clear_fraction": 0.1
    }
  },
  "layouts": {
    "face_full": {
      "description": "Speaker fills frame."
    },
    "face_corner": {
      "description": "Speaker in a rounded PiP, graphic behind.",
      "pip": {
        "width_fraction": 0.36,
        "corner": "bottom_left",
        "margin_px": 48,
        "radius_px": 28,
        "border_px": 3,
        "border_color": "surface"
      }
    },
    "graphic_full": {
      "description": "Full-frame graphic; speaker audio only."
    },
    "screen": {
      "description": "Screen recording with speaker PiP.",
      "pip": {
        "width_fraction": 0.28,
        "corner": "bottom_right_above_safe",
        "margin_px": 48,
        "radius_px": 28
      }
    },
    "split_top": {
      "description": "Graphic panel in the top 50 % of a 9:16 frame (measured on the reference reel), speaker fills the bottom; captions sit at the panel's bottom edge, small.",
      "panel": {
        "top_fraction": 0.5,
        "color": "paper",
        "dot_grid": true,
        "text": "ink",
        "dots": "ink",
        "dots_opacity": 0.06
      },
      "caption": {
        "y_fraction": 0.465,
        "size_px": 64,
        "words_per_cue": {
          "target": 2,
          "max": 3
        }
      }
    }
  },
  "profiles": {
    "vertical": {
      "width": 1080,
      "height": 1920,
      "fps": 30
    },
    "horizontal": {
      "width": 1920,
      "height": 1080,
      "fps": 30
    }
  },
  "motion": {
    "easing": "cubic",
    "enter_ms": 350,
    "exit_ms": 250,
    "min_gap_between_new_elements_s": 3,
    "pop_ms": 170,
    "swap_ms": 250,
    "fade_ms": 125,
    "_note": "enter/exit 350/250 are for large panels and windows; pop = a card or word landing, swap = one item replacing another, fade = small reveals. Measured on the 2026-11-16 reference reel, see brand/motion.md."
  },
  "sound": {
    "music_under_speech_db": -12,
    "max_sfx_per_30s": 8,
    "target_lufs": -14,
    "true_peak_dbtp": -1,
    "sfx_dir": "brand/sfx",
    "music_dir": "brand/music"
  },
  "vocabulary": {
    "_note": "Applied word-for-word after transcription (case-insensitive match on the misheard phrase). Add names, products, clients. Keep phrases short.",
    "fixes": [
      {
        "heard": "Muni Rabasi",
        "say": "Munir Abbasi"
      },
      {
        "heard": "Munir Abasi",
        "say": "Munir Abbasi"
      },
      {
        "heard": "clot code",
        "say": "Claude Code"
      },
      {
        "heard": "cloud code",
        "say": "Claude Code"
      },
      {
        "heard": "clawed code",
        "say": "Claude Code"
      },
      {
        "heard": "clod",
        "say": "Claude"
      },
      {
        "heard": "hyperframes",
        "say": "HyperFrames"
      }
    ],
    "always_capitalize": [
      "Claude",
      "Claude Code",
      "HyperFrames",
      "Parakeet",
      "Innova",
      "Alomana"
    ]
  }
}
